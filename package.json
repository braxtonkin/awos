{
  "name": "autoworker",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint -- . && npm run boundaries",
    "boundaries": "depcruise --config .dependency-cruiser.json --output-type err .",
    "lint": "eslint --config eslint.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "verify": "node tools/verify/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
